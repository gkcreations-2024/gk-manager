<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GK Creations — Task Analytics</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <!-- Header -->
  <header>
    <div class="header-container">
      <div class="logo">
        <div class="logo-icon"><i class="fa-solid fa-list-check"></i></div>
        <div class="logo-text">
          <h1>GK Creations</h1>
          <p>Staff Operations Management</p>
        </div>
      </div>
      <div class="stats-bar">
        <div class="stat-card"><span><i class="fa-solid fa-layer-group"></i> Total</span><strong><%= stats.total %></strong></div>
        <div class="stat-card"><span><i class="fa-solid fa-clock"></i> Pending</span><strong><%= stats.pending %></strong></div>
        <div class="stat-card"><span><i class="fa-solid fa-spinner"></i> Process</span><strong><%= stats.processing %></strong></div>
        <div class="stat-card"><span><i class="fa-solid fa-circle-check"></i> Done</span><strong><%= stats.completed %></strong></div>
      </div>
    </div>
  </header>

  <!-- Navigation -->
 <nav>
  <div class="nav-container">
    <!-- Desktop Tabs View -->
    <div class="nav-tabs">
      <a href="/" class="<%= activeTab === 'active' ? 'active' : '' %>">
        <i class="fa-solid fa-tasks"></i> Active Workload
      </a>
      <a href="/completed" class="<%= activeTab === 'completed' ? 'active' : '' %>">
        <i class="fa-solid fa-check-double"></i> Completed Tasks
      </a>
      <a href="/analytics" class="<%= activeTab === 'analytics' ? 'active' : '' %>">
        <i class="fa-solid fa-chart-pie"></i> Analytics
      </a>
    </div>

    <!-- Mobile Selecting Menu -->
    <div class="nav-select-wrapper">
      <select class="nav-select" onchange="window.location.href=this.value;">
        <option value="/" <%= activeTab === 'active' ? 'selected' : '' %>>
          📋 Active Workload
        </option>
        <option value="/completed" <%= activeTab === 'completed' ? 'selected' : '' %>>
          ✅ Completed Tasks
        </option>
        <option value="/analytics" <%= activeTab === 'analytics' ? 'selected' : '' %>>
          📊 Task Analytics
        </option>
      </select>
    </div>
  </div>
</nav>

  <!-- Analytics Body Container -->
  <div class="main-container">
    <div class="card">
      <h2 class="card-title">
        <i class="fa-solid fa-chart-line" style="color: var(--primary);"></i> 
        Overall Performance & Workload
      </h2>
      
      <!-- Key Metric Cards Grid -->
      <div class="form-grid" style="margin-top: 20px; margin-bottom: 30px;">
        <div class="stat-card" style="padding: 20px; text-align: center;">
          <span style="font-size: 0.75rem;"><i class="fa-solid fa-bullseye"></i> Completion Rate</span>
          <strong style="font-size: 2rem; color: #16a34a; margin-top: 8px;"><%= completionRate %>%</strong>
        </div>

        <div class="stat-card" style="padding: 20px; text-align: center;">
          <span style="font-size: 0.75rem;"><i class="fa-solid fa-users"></i> Active Staff</span>
          <strong style="font-size: 2rem; color: #2563eb; margin-top: 8px;"><%= staffCount %></strong>
        </div>

        <div class="stat-card" style="padding: 20px; text-align: center;">
          <span style="font-size: 0.75rem;"><i class="fa-solid fa-list-check"></i> Active Backlog</span>
          <strong style="font-size: 2rem; color: #d97706; margin-top: 8px;"><%= stats.pending + stats.processing %></strong>
        </div>

        <div class="stat-card" style="padding: 20px; text-align: center;">
          <span style="font-size: 0.75rem;"><i class="fa-solid fa-circle-check"></i> Finished Tasks</span>
          <strong style="font-size: 2rem; color: #059669; margin-top: 8px;"><%= stats.completed %></strong>
        </div>
      </div>

      <!-- Table Section with Responsive Wrapper -->
      <h3 class="card-title" style="font-size: 1rem; margin-bottom: 12px;">
        <i class="fa-solid fa-bars-staggered" style="color: #64748b;"></i> Task Status Breakdown
      </h3>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Status Category</th>
              <th>Count</th>
              <th>Percentage of Total</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><span class="badge pending"><i class="fa-solid fa-hourglass-half"></i> Pending Tasks</span></td>
              <td><strong><%= stats.pending %></strong></td>
              <td><%= stats.total > 0 ? Math.round((stats.pending / stats.total) * 100) : 0 %>%</td>
            </tr>
            <tr>
              <td><span class="badge in-progress"><i class="fa-solid fa-spinner"></i> In-Progress Tasks</span></td>
              <td><strong><%= stats.processing %></strong></td>
              <td><%= stats.total > 0 ? Math.round((stats.processing / stats.total) * 100) : 0 %>%</td>
            </tr>
            <tr>
              <td><span class="badge completed"><i class="fa-solid fa-check"></i> Completed Tasks</span></td>
              <td><strong><%= stats.completed %></strong></td>
              <td><%= stats.total > 0 ? Math.round((stats.completed / stats.total) * 100) : 0 %>%</td>
            </tr>
            <tr style="background: #f8fafc; font-weight: bold;">
              <td>Total Workload</td>
              <td><%= stats.total %></td>
              <td>100%</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
</html>